{
  "name": "wal-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Streams the write-ahead log of postgres A and prints every change as pretty-printed JSON.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:async": "PGPORT=5432 node src/index.js",
    "start:sync": "PGPORT=5442 node src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg-logical-replication": "^2.0.5"
  }
}
